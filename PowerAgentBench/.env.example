# Copy to PowerAgentBench/.env and replace YOUR_DEEPSEEK_API_KEY.
# Run commands from PowerAgentBench/. Do not commit .env.
# Base URL: the runner appends /chat/completions or /responses based on API_MODE.
POWERAGENTBENCH_OPENAI_URL=https://api.deepseek.com
POWERAGENTBENCH_OPENAI_API_KEY=YOUR_DEEPSEEK_API_KEY
POWERAGENTBENCH_OPENAI_MODEL=deepseek-flash
POWERAGENTBENCH_OPENAI_API_MODE=responses

# The runner sends the full history each turn (DeepSeek Responses is stateless).
# Keep this protocol unchanged across the 8 conditions and frozen Test.
